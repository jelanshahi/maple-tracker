node_modules/
dist/
*.tsbuildinfo

# Next.js build output.
#
# next-env.d.ts is generated too, and is ignored rather than committed: `next
# dev` points it at .next/dev/types while `next build` points it at
# .next/types, so committing it leaves the tree dirty after every switch
# between the two. Verified that `pnpm typecheck` passes with the file and the
# whole .next directory absent, and that it still catches a real type error in
# a .tsx file - so nothing is lost by leaving it out of a fresh clone.
.next/
next-env.d.ts

# Secrets. The service role key bypasses RLS - it never enters git.
.env
.env.local

# Supabase CLI local state
.supabase/

# OS noise
Thumbs.db
.DS_Store

# Supabase CLI scratch state
supabase/.temp/

# Claude Code local state. This holds git worktrees, each a full checkout with
# its own node_modules and .next - `git add .` without this rule tries to
# commit the entire tree into itself.
.claude/
