# Copy to .env and fill in. Never commit .env.
# Both are read by packages/ingester only, and validated with zod at startup.

# Supabase project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=

# Service role key. Bypasses RLS - ingester only, never a client, never logged.
SUPABASE_SERVICE_ROLE_KEY=

# Contact URL advertised in the outbound User-Agent against canada.ca.
INGEST_CONTACT_URL=
