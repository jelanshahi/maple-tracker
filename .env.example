# Copy to .env and fill in. Never commit .env.
# Both are read by packages/ingester only, and validated with zod at startup.

# Supabase project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=

# Service role key. Bypasses RLS - ingester only, never a client, never logged.
SUPABASE_SERVICE_ROLE_KEY=

# Contact URL advertised in the outbound User-Agent against canada.ca.
# Must be a page that actually loads and says who is running this and how to
# reach them. It is the courtesy that makes an automated reader acceptable on a
# government site, and a 404 here is worse than no URL at all: it advertises a
# contact and then fails to answer. Checked for URL syntax at startup, never for
# reachability - that is on you.
INGEST_CONTACT_URL=
