# Copy to .env and fill in. Never commit .env.
# Read by packages/ingester and apps/web, each validated with zod at startup.

# Supabase project URL, e.g. https://<ref>.supabase.co. Read by both.
SUPABASE_URL=

# Service role key. Bypasses RLS - ingester only, never a client, never logged.
# apps/web has no path to this: it is not in that package's environment schema.
SUPABASE_SERVICE_ROLE_KEY=

# Anon key. Subject to RLS, read by apps/web only.
# Deliberately NOT named NEXT_PUBLIC_ANON_KEY: that prefix is what inlines a
# value into the browser bundle. Without it the key stays server-side, and the
# pages that use it are server components, so no key reaches a visitor at all.
SUPABASE_ANON_KEY=

# Contact URL advertised in the outbound User-Agent against canada.ca.
# Must be a page that actually loads and says who is running this and how to
# reach them. It is the courtesy that makes an automated reader acceptable on a
# government site, and a 404 here is worse than no URL at all: it advertises a
# contact and then fails to answer. Checked for URL syntax at startup, never for
# reachability - that is on you.
INGEST_CONTACT_URL=
